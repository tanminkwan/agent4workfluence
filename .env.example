# 서비스 공통·서비스별 설정 예시. 복사해서 .env로 쓴다 (.env는 Git 제외).
# 코드에는 기본값이 없다. 아래 값을 모두 채워야 container가 시작한다.

# ── 이미지 (scripts/build.sh 와 docker-compose.yml 이 같이 읽는다)
PYTHON_BASE_IMAGE=python:3.12-slim
# runtime 이미지의 실행 사용자 uid. host에서 config/secrets(권한 600)를 가진 사용자의 uid (id -u)
A4W_UID=1001
DETECTION_IMAGE=a4w/detection
DETECTION_TAG=0.1.0

# ── Detection
DETECTION_PORT=18001
# none | bearer
DETECTION_AUTH_MODE=none
# DETECTION_AUTH_MODE=bearer 일 때만 쓴다
DETECTION_API_TOKEN=
DETECTION_SPEC_STORE_PATH=/data/spec-store
DETECTION_TARGETS_DIR=/config/targets
DETECTION_TEXT_DIFF_CONTEXT_LINES=3
# Phase 2 보강 (타겟 창구): 타겟 비밀 디렉터리(<targetId>.env, 없는 타겟은 검증 꺼짐), 검증 요청 tool 상한, 기록 보관 날 수
DETECTION_SECRETS_DIR=/config/secrets/targets
DETECTION_VERIFY_MAX_TOOLS=100
DETECTION_VERIFY_RESULT_DAYS=30
# live 시험(scripts/test.sh)이 붙일 비밀: config/secrets 아래 디렉터리(→ <SERVICE>_SECRETS_DIR) 또는 .env 파일(→ --env-file)
DETECTION_TEST_SECRETS=targets
TARGETS=workfluence
LOG_LEVEL=INFO

# ── container 안에서 이름을 못 찾는 내부 호스트 (host의 /etc/hosts에만 있는 경우). "이름:IP"
TARGET_HOST_ALIAS=wf.internal:10.10.20.11

# ── container 실행 시 proxy (내부 주소는 호스트 이름으로 NO_PROXY에 넣는다)
HTTP_PROXY=http://10.10.10.205:3128
HTTPS_PROXY=http://10.10.10.205:3128
NO_PROXY=localhost,127.0.0.1,wf.internal,detection,manufacture,host.docker.internal

# ── Manufacture (Phase 2). 타겟 주소·token은 없다 (타겟 창구는 Detection)
MANUFACTURE_IMAGE=a4w/manufacture
MANUFACTURE_TAG=0.1.0
MANUFACTURE_PORT=18002
# none | bearer
MANUFACTURE_AUTH_MODE=none
# MANUFACTURE_AUTH_MODE=bearer 일 때만 쓴다
MANUFACTURE_API_TOKEN=
MANUFACTURE_TOOL_STORE_PATH=/data/tool-store
MANUFACTURE_TARGETS_DIR=/config/targets
MANUFACTURE_PROMPTS_DIR=/src/agents/manufacture/prompts
# live 시험이 붙일 비밀 (config/secrets 아래)
MANUFACTURE_TEST_SECRETS=manufacture-llm.env
# live 시험 container가 더 닿아야 하는 이름 (AI Pro Plus)
MANUFACTURE_TEST_HOSTS=host.docker.internal:host-gateway
# live 시험이 부를 실행 중인 Detection (compose가 host에 연 포트)
MANUFACTURE_LIVE_DETECTION_URL=http://host.docker.internal:18001
DETECTION_BASE_URL=http://detection:18001
# Detection이 bearer일 때 보낼 토큰 (비우면 헤더 없음)
DETECTION_CLIENT_TOKEN=
DETECTION_TIMEOUT_SECONDS=30
DETECTION_VERIFY_POLL_SECONDS=5
DETECTION_VERIFY_TIMEOUT_SECONDS=1800
# LLM (주소·key는 config/secrets/manufacture-llm.env)
# openai_compatible (구현) | anthropic · claude_cli (자리만)
LLM_PROVIDER=openai_compatible
LLM_MODEL=zai-org/GLM-5.2
# json_object (기본) | json_schema
LLM_RESPONSE_FORMAT=json_object
# 비우면 보내지 않는다
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=32000
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
LLM_MAX_CALLS_PER_APPLY=60
LLM_EXAMPLE_COUNT=3
LLM_PROPOSE_COMPOSITES=false
# tool 하나의 보이는 입력 칸 상한 (작은 모델이 고민할 칸을 줄인다)
TOOL_MAX_VISIBLE_INPUTS=4
# 작업별 프롬프트 버전 (prompts/<작업>.v<번호>.md)
PROMPT_VERSIONS=common=v1,tool_create=v1,tool_update=v1,tool_redescribe=v1
# tool 글 길이 상한 (설명, 요약, 예시 질의)
TOOL_TEXT_LIMITS=description=600,summary=120,example=60
# RAG (AI Pro Plus). 시험 서버는 nobody 모드: Authorization 없이 X-Virtual-User만
RAG_PROVIDER=aipro_plus
RAG_BASE_URL=http://host.docker.internal:28000
# none | bearer (bearer면 config/secrets/rag.env의 RAG_API_KEY)
RAG_AUTH_MODE=none
RAG_VIRTUAL_USER=aiagent4workfluence
RAG_TIMEOUT_SECONDS=30
RAG_MAX_ATTEMPTS=3
RAG_COLLECTION_PREFIX=a4w_tools_
RAG_DOMAIN_PREFIX=a4w-tools-
RAG_CONTENT_MAX_CHARS=600
RAG_LIST_LIMIT=1000
INDEX_EVAL_TOP_N=5
INDEX_EVAL_MIN_HIT_RATE=0.9

# ── 공용 MCP server (Phase 3, a4w_mcp). agent마다 stdio 프로세스 하나. compose 서비스는 Phase 4(inference)
MCP_IMAGE=a4w/mcp
MCP_TAG=0.1.0
# 이 프로세스의 agent와 그 agent가 쓰는 타겟
MCP_AGENT_ID=aiagent
MCP_TARGETS=workfluence
MCP_TARGETS_DIR=/config/targets
# agent 설정 config/agents/<agentId>/<targetId>.env, agent 비밀 config/secrets/agents/<agentId>/<targetId>.env
MCP_AGENTS_DIR=/config/agents
MCP_SECRETS_DIR=/config/secrets/agents
# tool 정의 조회 API (Manufacture). bearer면 MCP_MANUFACTURE_TOKEN (비우면 헤더 없음)
MCP_MANUFACTURE_URL=http://manufacture:18002
MCP_MANUFACTURE_TOKEN=
MCP_MANUFACTURE_TIMEOUT_SECONDS=10
# 버전 확인 간격, 실패 뒤 다시 시도까지 (초)
MCP_REFRESH_SECONDS=60
MCP_REFRESH_RETRY_SECONDS=10
# stdio (구현) | streamable_http (자리만)
MCP_TRANSPORT=stdio
# MCP tool 이름 = targetId + 구분자 + tool 이름 (OpenAI 호환 function 이름 규칙에 맞춘다)
MCP_TOOL_NAME_SEPARATOR=__
MCP_TOOL_NAME_MAX=64
MCP_MAX_CONCURRENT_CALLS=4
# token scope를 읽을 수 없을 때: fail (뜨지 않음) | all (거르지 않음)
MCP_SCOPE_UNKNOWN=fail
# live 시험: 실행 중인 Manufacture(compose가 host에 연 포트), 붙일 비밀(config/secrets 아래), 닿아야 하는 이름, 바탕 페이지 제목
MCP_LIVE_MANUFACTURE_URL=http://host.docker.internal:18002
MCP_TEST_SECRETS=agents
MCP_TEST_HOSTS=host.docker.internal:host-gateway
MCP_LIVE_PAGE_TITLE=a4w 시험 바탕 페이지

# ── Inference (Phase 4). 설명은 docs/phase4_inference/2_설계.md 4.2절. 코드에는 기본값이 없다
INFERENCE_IMAGE=a4w/inference
INFERENCE_TAG=0.1.0
INFERENCE_PORT=18003
# none | bearer (bearer면 INFERENCE_API_TOKEN)
INFERENCE_AUTH_MODE=none
INFERENCE_API_TOKEN=
INFERENCE_STORE_PATH=/var/lib/a4w/inference
# 서비스가 띄울 agent (config/agents/<agentId>/_agent.env 가 있어야 한다)
INFERENCE_AGENTS=aiagent
INFERENCE_AGENTS_DIR=/config/agents
INFERENCE_TARGETS_DIR=/config/targets
# 시스템 프롬프트: 파일(권장) 또는 INFERENCE_SYSTEM_PROMPT. 둘 다 없으면 기동하지 않는다. 문구는 코드에 없다
INFERENCE_SYSTEM_PROMPT_FILE=/config/prompts/system.md
INFERENCE_TIMEZONE=Asia/Seoul
INFERENCE_TEXT_MAX_CHARS=8000
INFERENCE_REQUESTER_MAX_CHARS=128
INFERENCE_MAX_CONCURRENT_PER_AGENT=2
INFERENCE_RETENTION_DAYS=30
INFERENCE_PURGE_INTERVAL_SECONDS=3600
INFERENCE_HISTORY_MAX_TURNS=50
# tool 검색: 타겟당 상위 K, 점수 컷(0 = 끔: Phase 2 평가에서 점수로는 적중과 실패를 가를 수 없었다), 질의에 합칠 앞선 요청자 text 수
INFERENCE_SEARCH_TOP_K=12
INFERENCE_SEARCH_MIN_SCORE=0
INFERENCE_SEARCH_HISTORY_TURNS=3
INFERENCE_SEARCH_QUERY_MAX_CHARS=1000
# 검색 창 안의 앞선 차례에서 성공한 tool을 후보에 넣는다 (Phase 4 설계 20.3절, 이어 가는 요청)
INFERENCE_SEARCH_KEEP_HISTORY_TOOLS=true
# 검색어 다듬기 (Phase 4 설계 20절): 검색 전에 모델이 대화를 보고 검색 문장 한 줄을 쓴다. 파일을 비우면 끔(원문 이어 붙이기)
INFERENCE_SEARCH_REWRITE_PROMPT_FILE=/config/prompts/search_rewrite.md
INFERENCE_SEARCH_REWRITE_MAX_OUTPUT_TOKENS=512
INFERENCE_SEARCH_REWRITE_ANSWER_MAX_CHARS=300
# LLM (주소·key는 config/secrets/inference-llm.env). 비우면 보내지 않는 값: 온도·추론 강도
INFERENCE_LLM_PROVIDER=openai_compatible
INFERENCE_LLM_MODEL=openai/gpt-oss-120b
INFERENCE_LLM_TIMEOUT_SECONDS=120
INFERENCE_LLM_MAX_OUTPUT_TOKENS=4096
INFERENCE_LLM_TEMPERATURE=0.2
INFERENCE_LLM_REASONING_EFFORT=low
INFERENCE_LLM_MAX_RETRIES=2
# 한 요청의 한도: 모델 차례, tool 호출, 쓰기 호출, 전체 시간(초), 같은 tool·같은 오류 반복, 다시 찾기 횟수
INFERENCE_MAX_STEPS=12
INFERENCE_MAX_TOOL_CALLS=12
INFERENCE_MAX_WRITE_CALLS=10
INFERENCE_MAX_SECONDS=300
INFERENCE_MAX_SAME_ERROR=2
INFERENCE_RETRY_SEARCH_MAX=1
# ── 입력 크기(context). 모델에 보내는 입력 전체(프롬프트·tool 정의·대화 이력·이번 요청·tool 결과)가 기준이다.
# 크기를 정확히 재기 어려우므로(서버 chat template, tool 정의 변환, 첫 호출 전에는 실측이 없다) 안전하게 설정한다.
#  - 판정 상한 = MAX_INPUT_TOKENS × SAFETY_RATIO. 이 여유가 어림 오차와 출력 토큰이 같은 창을 쓰는 부분을 덮는다
#  - CHARS_PER_TOKEN은 작을수록 토큰을 많이 세어 안전하다 (한국어·JSON·영문 식별자가 섞이면 1~2자/토큰)
#  - 시험에서 실측/어림 비율의 최댓값 r_max를 구해 SAFETY_RATIO ≤ 1/r_max 로, 한 단계 더 낮춰 잡는다 (설계 6.7.1)
#  - 모델이 입력 초과로 거절한 적이 한 번이라도 있으면 SAFETY_RATIO를 낮춘다
INFERENCE_MAX_INPUT_TOKENS=131072
INFERENCE_INPUT_SAFETY_RATIO=0.8
INFERENCE_CHARS_PER_TOKEN=1.5
INFERENCE_TOOL_RESULT_MAX_CHARS=20000
INFERENCE_TRIM_KEEP_CHARS=1500
# "AI agent 작성" 표시: 쓰기 tool의 글 끝에 붙는다 (\n은 줄바꿈). 칸은 config/agents/<agent>/<타겟>.env의 AGENT_WRITE_MARKS
INFERENCE_AI_MARK_SUFFIX=\n\n---\n_AI agent가 작성한 글입니다._
INFERENCE_RECORD_ARG_MAX_CHARS=200
# 대화 기록에 tool마다 남기는 결과 식별자(id 등) 수 상한 (Phase 4 설계 19절)
INFERENCE_HISTORY_REFS_MAX=6
# MCP 자식 프로세스에 넘길 환경변수 (허용 목록). INFERENCE_·LLM_·RAG_ 이름은 넣을 수 없다
INFERENCE_MCP_CHILD_ENV_PREFIXES=MCP_,LOG_LEVEL
INFERENCE_MCP_CHILD_ENV_NAMES=PATH,HTTP_PROXY,HTTPS_PROXY,NO_PROXY,http_proxy,https_proxy,no_proxy,SSL_CERT_FILE
INFERENCE_MCP_RESTART_BACKOFF_SECONDS=1
INFERENCE_MCP_RESTART_BACKOFF_MAX_SECONDS=30
INFERENCE_MCP_START_TIMEOUT_SECONDS=30
INFERENCE_MCP_TOOLS_WAIT_SECONDS=10
INFERENCE_MCP_PING_SECONDS=5
# 평가 기준 (설계 14.3)
INFERENCE_EVAL_MIN_SEARCH_HIT_RATE=0.9
INFERENCE_EVAL_MIN_SUCCESS_RATE=0.8
# live 시험이 붙일 비밀·설정과 닿아야 하는 이름
INFERENCE_TEST_SECRETS=inference-llm.env,agents,targets/workfluence.peer.env
INFERENCE_SECRETS_DIR=/config/secrets/agents
INFERENCE_TEST_HOSTS=host.docker.internal:host-gateway
# 채팅 live 시험의 고정 방 id (Phase 5 설계 13.3). 요청자 계정(peer)이 한 번 만들어 재사용한다. 비우면 채팅 live 시험은 건너뛴다
INFERENCE_LIVE_CHAT_DIRECT_ROOM=
INFERENCE_LIVE_CHAT_GROUP_ROOM=
INFERENCE_LIVE_MANUFACTURE_URL=http://host.docker.internal:18002
# live 시험이 부를 실행 중인 Inference (compose가 host에 연 포트)
INFERENCE_LIVE_BASE_URL=http://host.docker.internal:18003

# ── Workfluence 채팅 채널 (Phase 5). 설명은 docs/phase5_chat/2_설계.md 7절. 코드에는 기본값이 없다
# 꺼 두면(false) Phase 4와 똑같이 동작한다. 켜기 전에 채팅 token(config/secrets/chat/<agent>/<target>.env)과 문구 파일이 필요하다
CHAT_ENABLED=false
CHAT_AGENT_ID=aiagent
CHAT_TARGET_ID=workfluence
CHAT_API_ADAPTER=workfluence
# 채팅 REST 기준 주소(…/api/v1). WebSocket 주소는 여기서 만든다
CHAT_API_BASE_URL=https://wf.internal:8444/api/v1
CHAT_TLS_CA_FILE=/config/targets/workfluence-ca.pem
# 여럿 방에서 이 이름이 본문에 있을 때만 답한다(서버에 멘션 기능이 없다). 1:1 방은 모든 메시지에 답한다
CHAT_MENTION_NAME=AI Agent
# 쓰기를 허용할 요청자 senderId(쉼표 구분). 비우면 아무도 쓰기를 못 한다
CHAT_WRITE_ALLOWED_USERS=
# 짧은 답 상한(서버 본문 상한 CHAT_MAX_MESSAGE_CHARS보다 작아야 한다), 보내기 속도(서버 한도 이하)
CHAT_ANSWER_MAX_CHARS=600
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_SERVER_SEND_PER_MINUTE=60
CHAT_SEND_PER_MINUTE=50
CHAT_SEND_RETRY_MAX=3
CHAT_SEND_RETRY_SECONDS=5
CHAT_SEND_RETRY_WAIT_MAX_SECONDS=60
# 연결·재연결
CHAT_RECONNECT_INITIAL_SECONDS=1
CHAT_RECONNECT_MAX_SECONDS=60
CHAT_CONFLICT_LIMIT=3
CHAT_PING_INTERVAL_SECONDS=20
CHAT_PING_TIMEOUT_SECONDS=20
CHAT_OPEN_TIMEOUT_SECONDS=10
CHAT_HTTP_TIMEOUT_SECONDS=15
# 놓친 메시지 보충(서버는 한 번에 200개까지)과 너무 오래된 메시지 건너뛰기
CHAT_CATCHUP_PAGE=200
CHAT_CATCHUP_MAX_AGE_SECONDS=86400
# 수행 결과 기다림(수행 시간 상한 INFERENCE_MAX_SECONDS 이상), 방 큐, 바쁠 때 재시도
CHAT_POLL_INTERVAL_SECONDS=0.5
CHAT_WAIT_MAX_SECONDS=420
CHAT_ROOM_QUEUE_MAX=5
CHAT_BUSY_RETRY_SECONDS=2
CHAT_BUSY_RETRY_MAX_SECONDS=120
# 고정 응답 문구(YAML)와 채팅 전용 프롬프트 덧붙임(선택). 예시는 config/prompts/*.example
CHAT_REPLIES_FILE=/config/prompts/chat_replies.yaml
CHAT_NOTES_FILE=/config/prompts/chat_notes.md
# 덧붙임의 ${room_members}에 넣을 방 참여자 수 상한, 표시 이름 길이 상한 (Phase 5 설계 18절)
CHAT_NOTES_MEMBERS_MAX=50
CHAT_NOTES_NAME_MAX_CHARS=64
# 채팅 상태 DB(Inference 전용 볼륨 안)와 처리 기록 보관 날 수
CHAT_STATE_PATH=/var/lib/a4w/inference/chat.db
CHAT_RETENTION_DAYS=30
# 채팅 token 디렉터리. 본체만 읽는다(MCP 자식이 읽는 agent token과 다른 디렉터리)
CHAT_SECRETS_DIR=/config/secrets/chat
