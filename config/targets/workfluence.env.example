# Workfluence 타겟 설정 예시. 복사해서 workfluence.env로 쓴다 (Git 제외).
# 파일 이름(workfluence)이 targetId다. 비밀(token)은 넣지 않는다 → config/secrets/
TARGET_ADAPTER=workfluence
# hash_url (구현) | no_hash (자리만)
SPEC_SOURCE=hash_url
# yaml (구현) | json (자리만)
SPEC_FORMAT=yaml
# identity (구현) | canonical (자리만)
SPEC_NORMALIZER=identity
SPEC_URL=https://wf.internal:8444/api/v1/openapi.yaml
SPEC_HASH_URL=https://wf.internal:8444/api/v1/openapi.sha256
SPEC_MAX_BYTES=20000000
HTTP_TIMEOUT_SECONDS=30
TLS_VERIFY=true
# 시험 스택은 자체 서명 인증서다. 서버 인증서를 받아 CA 파일로 쓴다.
#   openssl s_client -connect wf.internal:8444 -servername wf.internal -showcerts </dev/null \
#     | awk '/BEGIN CERT/,/END CERT/' > config/targets/workfluence-ca.pem
TLS_CA_FILE=/config/targets/workfluence-ca.pem
REVIEW_POLICY=workfluence_v1_additive
