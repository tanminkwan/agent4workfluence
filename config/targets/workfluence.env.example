# Workfluence 타겟 설정 예시. 복사해서 workfluence.env로 쓴다 (Git 제외).
# 파일 이름(workfluence)이 targetId다. 비밀(token)은 넣지 않는다 → config/secrets/targets/
TARGET_ADAPTER=workfluence
# hash_url (구현) | no_hash (자리만)
SPEC_SOURCE=hash_url
# yaml (구현) | json (자리만)
SPEC_FORMAT=yaml
# identity (구현) | canonical (자리만)
SPEC_NORMALIZER=identity
SPEC_URL=https://wf.internal:8444/api/v1/openapi.yaml
SPEC_HASH_URL=https://wf.internal:8444/api/v1/openapi.sha256
SPEC_MAX_BYTES=20000000
HTTP_TIMEOUT_SECONDS=30
TLS_VERIFY=true
# 시험 스택은 자체 서명 인증서다. 서버 인증서를 받아 CA 파일로 쓴다.
#   openssl s_client -connect wf.internal:8444 -servername wf.internal -showcerts </dev/null \
#     | awk '/BEGIN CERT/,/END CERT/' > config/targets/workfluence-ca.pem
TLS_CA_FILE=/config/targets/workfluence-ca.pem
REVIEW_POLICY=workfluence_v1_additive

# ── Phase 2: tool 만들기 (manufacture가 읽음)
TOOL_CATALOG=workfluence_v1
# 켤 묶음. 위험 동작(danger)은 기본 꺼짐이고, 켜도 추가는 사람 확인을 거친다
TOOL_GROUPS_ENABLED=read,history,communication,authoring
TOOL_REQUEST_CONTENT_TYPES=application/json,multipart/form-data
RESPONSE_MAX_CHARS=8000
# 시나리오가 없는 tool: pending | exclude
VERIFY_NO_SCENARIO=pending

# ── Phase 2: 타겟 호출·실호출 검증 (detection이 읽음, 타겟 비밀은 config/secrets/targets/)
# 명세의 경로가 붙는 앞머리 (명세: "주소 = 서버 주소 + /api/v1")
TARGET_API_PATH_PREFIX=/api/v1
# token scope 확인: workfluence_jwt (token의 scope 클레임) | config (TARGET_TOKEN_SCOPES)
TARGET_SCOPE_PROVIDER=workfluence_jwt
TARGET_TOKEN_SCOPES=
CALL_READ_PER_MINUTE=120
CALL_WRITE_PER_MINUTE=30
CALL_MAX_ATTEMPTS=3
CALL_MAX_RETRY_WAIT_SECONDS=60
CALL_TIMEOUT_SECONDS=30
CALL_ERROR_INTERPRETER=workfluence
VERIFY_SANDBOX=workfluence_space
# 검증마다 만드는 시험 스페이스 이름 앞머리 (이 앞머리의 스페이스는 다음 검증이 지운다)
VERIFY_SPACE_PREFIX=aiagent-manufacture-
# 이 scope가 필요한 tool은 검증하지 않는다
VERIFY_DENY_SCOPES=admin
# 검증 상대 계정 (선택, 설계 11.6.1): 알림 tool 검증용. 비밀 파일은 타겟 비밀 디렉터리 안 (Detection에만 붙음)
VERIFY_PEER_SECRETS=workfluence.peer.env
VERIFY_PEER_USERNAME=aiagent-peer
# 검증 계정(agent)의 username — peer가 @멘션할 이름
VERIFY_AGENT_USERNAME=aiagent

# ── 실행하는 쪽(Inference의 공용 MCP server, Phase 3·4)이 읽는 agent 고정 맥락 (설계 6.3.1)
# 키=값,... 형식. homeSpace는 agent의 기본 스페이스 id (검증 때는 Detection이 시험 스페이스로 채운다)
AGENT_CONTEXT=homeSpace=<agent 기본 스페이스 id>
