# agent가 타겟에서 쓰는 설정 예시. 복사해서 config/agents/<agentId>/<targetId>.env로 쓴다 (Git 제외). 비밀은 넣지 않는다
# 고정 맥락 키=값,... (Phase 2 설계 6.3.1). homeSpace = agent의 기본 스페이스 id
AGENT_CONTEXT=homeSpace=<agent 기본 스페이스 id>
# 내보낼 tool의 위험 상한: read | write | danger (Inference는 danger를 쓰지 않는다: write)
AGENT_TOOL_MAX_RISK=write
# 내보낼 묶음 (쉼표 구분), * 이면 전부
AGENT_TOOL_GROUPS=*
# 쓰기 tool의 "AI agent 작성" 표시 칸 (Phase 4 설계 7.2). tool:칸[+칸] 또는 tool:-(글을 쓰는 칸 없음). 목록에 없는 쓰기 tool은 실행되지 않는다
AGENT_WRITE_MARKS=create_page:body,update_page:body,add_comment:body,edit_comment:body,comment_on_page_by_title:body,add_page_label:-,remove_page_label:-,label_page_by_title:-,delete_comment:-,mark_notification_read:-,mark_all_notifications_read:-
