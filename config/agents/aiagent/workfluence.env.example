# agent가 타겟에서 쓰는 설정 예시. 복사해서 config/agents/<agentId>/<targetId>.env로 쓴다 (Git 제외). 비밀은 넣지 않는다
# 고정 맥락 키=값,... (Phase 2 설계 6.3.1). homeSpace = agent의 기본 스페이스 id
AGENT_CONTEXT=homeSpace=<agent 기본 스페이스 id>
# 내보낼 tool의 위험 상한: read | write | danger
AGENT_TOOL_MAX_RISK=danger
# 내보낼 묶음 (쉼표 구분), * 이면 전부
AGENT_TOOL_GROUPS=*
