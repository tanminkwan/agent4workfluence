{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "search_pages",
  "title": "페이지 검색",
  "description": "기본 스페이스에서 제목과 본문으로 페이지를 찾는다. 검색어는 두 글자부터 된다. 결과의 pageId로 다른 tool을 부른다. 기본 20개까지 돌려준다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "q": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
        "description": "검색어 — 요청 글의 핵심 낱말. 두 글자 이상, 200자까지"
      }
    },
    "required": [
      "q"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "GET",
    "path": "/search",
    "bindings": [
      {
        "input": "q",
        "in": "query",
        "name": "q"
      }
    ],
    "fixed": [
      {
        "in": "query",
        "name": "space",
        "context": "homeSpace"
      }
    ],
    "omitted": [
      "limit"
    ],
    "success": [
      200
    ]
  },
  "response": {
    "fields": [
      "items[].pageId",
      "items[].title",
      "items[].snippet",
      "items[].updatedAt"
    ],
    "maxChars": 8000
  },
  "risk": "read",
  "scopes": [
    "read"
  ],
  "group": "read",
  "index": {
    "summary": "제목을 모를 때 단어로 여러 스페이스의 페이지 제목·본문을 검색해 관련 글을 찾는다",
    "examples": [
      "휴가 규정이 나온 글 찾아줘",
      "온콜이라는 말이 들어간 문서 검색",
      "OKR 관련 페이지 있는지 찾아봐",
      "신입 교육 자료 어디 있어?",
      "어떤 문서에 API 키 얘기가 있었지?",
      "단어로 페이지 검색하기",
      "Search pages about deployment",
      "Find documents mentioning vacation policy"
    ]
  },
  "source": {
    "operationId": "search.find",
    "method": "GET",
    "path": "/search",
