{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "search_pages",
  "title": "페이지 검색",
  "description": "스페이스(지정하지 않으면 agent의 기본 스페이스)에서 제목과 본문으로 페이지를 찾는다. 검색어는 두 글자부터 된다. 결과의 pageId로 다른 tool을 부른다. 기본 20개까지 돌려준다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "q": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
        "description": "검색어 — 요청 글의 핵심 낱말. 두 글자 이상, 200자까지"
      },
      "space": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
        "description": "스페이스 이름이나 id — 요청에 스페이스가 있을 때만 넣는다(예: 'Crazy Study에'). 비우면 agent의 기본 스페이스"
      },
      "createdBy": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
        "description": "만든 사람의 아이디(username) — 요청에 만든 사람('네가·내가·○○가 만든')이 있을 때만 넣는다. 나는 내 아이디, 방 참여자는 참여자 목록의 username"
      },
      "updatedBy": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
        "description": "마지막으로 고친 사람의 아이디(username) — 요청에 고친 사람이 있을 때만 넣는다"
      }
    },
    "required": [
      "q"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "GET",
    "path": "/search",
    "bindings": [
      {
        "input": "q",
        "in": "query",
        "name": "q"
      },
      {
        "input": "space",
        "in": "query",
        "name": "space",
        "contextDefault": "homeSpace"
      },
      {
        "input": "createdBy",
        "in": "query",
        "name": "createdBy"
      },
      {
        "input": "updatedBy",
        "in": "query",
        "name": "updatedBy"
      }
    ],
    "fixed": [],
    "omitted": [
      "limit"
    ],
    "success": [
      200
    ]
  },
  "response": {
    "fields": [
      "items[].pageId",
      "items[].title",
      "items[].snippet",
      "items[].updatedAt",
      "items[].createdByName",
      "items[].updatedByName"
    ],
    "maxChars": 8000
  },
  "risk": "read",
  "scopes": [
    "read"
  ],
  "group": "read",
  "index": {
    "summary": "제목을 모를 때 단어로 여러 스페이스의 페이지 제목·본문을 검색해 관련 글을 찾는다",
    "examples": [
      "휴가 규정이 나온 글 찾아줘",
      "온콜이라는 말이 들어간 문서 검색",
      "OKR 관련 페이지 있는지 찾아봐",
      "신입 교육 자료 어디 있어?",
      "민수가 쓴 글 중에 회의록 찾아줘",
      "단어로 페이지 검색하기",
      "Search pages about deployment",
      "Find documents mentioning vacation policy"
    ]
  },
  "source": {
    "operationId": "search.find",
    "method": "GET",
    "path": "/search",
    "specVersion": "4283c9bf8068f47335af33c9f1bf722e501b1f36d4ed5aad7aed4ab9d8ee60ad",
    "fragmentSha256": "54e35bf9808c08ac4a3d06e01352715a125414957e3f7a365cd5e492ee6d02bb",
    "structureSha256": "5eb623c2d8fc99adcd34f5050ed4e3fc6d9fe2ce479690e146a1b6ec6d144390"
  },
  "origin": "seed",
  "revision": "r-92db600d93d2"
}
