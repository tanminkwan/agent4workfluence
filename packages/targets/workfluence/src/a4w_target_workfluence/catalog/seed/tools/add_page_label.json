{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "add_page_label",
  "title": "페이지에 라벨 붙이기",
  "description": "페이지에 라벨(태그)을 붙인다. 없는 라벨이면 만든다. 이름은 소문자로 저장된다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pageId": {
        "format": "uuid",
        "type": "string",
        "description": "페이지 id — search_pages 결과의 items[].pageId"
      },
      "name": {
        "description": "라벨 이름 — 40자까지",
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "pageId",
      "name"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "POST",
    "path": "/pages/{pageId}/labels",
    "contentType": "application/json",
    "bindings": [
      {
        "input": "pageId",
        "in": "path",
        "name": "pageId"
      },
      {
        "input": "name",
        "in": "body",
        "pointer": "/name"
      }
    ],
    "fixed": [],
    "success": [
      201
    ]
  },
  "response": {
    "fields": [
      "id",
      "name"
    ],
    "maxChars": 8000
  },
  "risk": "write",
  "scopes": [
    "write"
  ],
  "group": "authoring",
  "index": {
    "summary": "이미 고른 페이지(id를 앎)에 라벨(태그)을 붙인다",
    "examples": [
      "이 문서에 긴급 태그 붙여",
      "페이지에 보안 라벨 달아줘",
      "검토중 라벨 추가해줘",
      "그 글 태그 달아줘",
      "문서를 라벨로 분류해줘",
      "페이지에 라벨 붙이기",
      "Add a label to this page",
      "Tag this page as urgent"
    ]
  },
  "source": {
