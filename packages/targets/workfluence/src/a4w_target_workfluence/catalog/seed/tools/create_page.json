{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "create_page",
  "title": "새 페이지 만들기",
  "description": "agent의 기본 스페이스 맨 위에 새 페이지를 만든다. 본문은 마크다운이고 원시 HTML·그림·허용 밖 링크는 400이다. 만들기는 실패해도 만들어졌을 수 있으니 다시 하기 전에 search_pages로 확인한다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "body": {
        "description": "본문 (마크다운 글). 템플릿을 쓰면 list_templates 결과의 body"
      },
      "title": {
        "description": "페이지 제목 — 300자까지",
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "body",
      "title"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "POST",
    "path": "/pages",
    "contentType": "application/json",
    "bindings": [
      {
        "input": "body",
        "in": "body",
        "pointer": "/body"
      },
      {
        "input": "title",
        "in": "body",
        "pointer": "/title"
      }
    ],
    "fixed": [
      {
        "in": "body",
        "pointer": "/space",
        "context": "homeSpace"
      }
    ],
    "omitted": [
      "format",
      "body_format",
      "parentId"
    ],
    "success": [
      201
    ]
  },
  "response": {
    "fields": [
      "id",
      "title",
      "currentVersionNo"
    ],
    "maxChars": 8000
  },
  "risk": "write",
  "scopes": [
    "write"
  ],
  "group": "authoring",
  "index": {
    "summary": "위키에 새 페이지(문서)를 만든다",
    "examples": [
      "회의록 페이지 새로 만들어줘",
      "오늘 작업 내용을 문서로 올려줘",
      "새 위키 페이지 작성해줘"
    ]
  },
