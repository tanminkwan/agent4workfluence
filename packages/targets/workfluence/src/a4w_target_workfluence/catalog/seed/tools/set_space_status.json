{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "set_space_status",
  "title": "스페이스 중지·다시 쓰기",
  "description": "스페이스를 중지(suspended)하거나 다시 쓰게(active) 한다. 중지하면 읽기만 되고 쓰기가 막힌다. 관리자가 건 중지는 풀 수 없다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "format": "uuid",
        "type": "string",
        "description": "스페이스 id — list_spaces 결과의 items[].id"
      },
      "status": {
        "description": "suspended(중지) 또는 active(다시 쓰기)",
        "enum": [
          "active",
          "suspended"
        ],
        "type": "string"
      }
    },
    "required": [
      "id",
      "status"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "PATCH",
    "path": "/spaces/{id}/status",
    "contentType": "application/json",
    "bindings": [
      {
        "input": "id",
        "in": "path",
        "name": "id"
      },
      {
        "input": "status",
        "in": "body",
        "pointer": "/status"
      }
    ],
    "fixed": [],
    "omitted": [
      "takeover"
    ],
    "success": [
      200
    ]
  },
  "response": {
    "fields": [
      "id",
      "name",
      "status"
    ],
    "maxChars": 8000
  },
  "risk": "danger",
  "scopes": [
    "write"
  ],
  "group": "danger",
  "index": {
    "summary": "스페이스를 중지하거나 다시 쓸 수 있게 상태를 바꾼다",
    "examples": [
      "스페이스 잠시 멈춰줘",
      "공간 다시 열어줘",
      "스페이스 동결",
      "중지된 공간 활성화",
      "스페이스 상태 바꿔줘",
      "스페이스 중지·다시 쓰기",
      "Suspend this space",
      "Reactivate the space"
    ]
  },
