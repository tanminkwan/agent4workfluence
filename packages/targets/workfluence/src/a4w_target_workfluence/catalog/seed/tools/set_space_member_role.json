{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "set_space_member_role",
  "title": "스페이스 Crew 역할 바꾸기",
  "description": "Crew 한 사람의 역할을 editor(고칠 수 있다)·viewer(읽기만)로 바꾼다. owner는 줄 수 없고 하나뿐인 owner는 내릴 수 없다. 바뀐 Crew 목록 전체를 돌려준다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "format": "uuid",
        "type": "string",
        "description": "스페이스 id — list_spaces 결과의 items[].id"
      },
      "ref": {
        "type": "string",
        "description": "바꿀 사람의 아이디(username) — list_space_members 결과의 username"
      },
      "role": {
        "description": "editor 또는 viewer",
        "enum": [
          "editor",
          "viewer"
        ],
        "type": "string"
      }
    },
    "required": [
      "id",
      "ref",
      "role"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "PATCH",
    "path": "/spaces/{id}/members/{ref}",
    "contentType": "application/json",
    "bindings": [
      {
        "input": "id",
        "in": "path",
        "name": "id"
      },
      {
        "input": "ref",
        "in": "path",
        "name": "ref"
      },
      {
        "input": "role",
        "in": "body",
        "pointer": "/role"
      }
    ],
    "fixed": [],
    "success": [
      200
    ]
  },
  "response": {
    "fields": [
      "[].username",
      "[].displayName",
      "[].role"
    ],
    "maxChars": 8000
  },
  "risk": "write",
  "scopes": [
    "write"
  ],
  "group": "authoring",
  "index": {
    "summary": "스페이스 Crew의 역할(편집자·읽기 전용)을 바꾼다. 사람을 넣거나 빼지 않는다",
    "examples": [
      "이 사람 편집 권한 줘",
      "뷰어로 바꿔줘",
      "멤버 역할 편집자로 올려",
      "Crew 권한 조정해줘",
      "역할을 viewer로 변경",
      "Crew 역할 바꾸기",
      "Make her an editor",
      "Change member role to viewer"
    ]
  },
