  "name": "download_attachment",
  "title": "첨부 내용 받기",
  "description": "첨부 파일 하나의 내용을 JSON으로 받는다. 글 파일은 utf8 글로, 이진 파일은 base64로 온다. 1000000바이트(기본값)를 넘으면 413이다. 받은 일은 감사로그에 남는다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "format": "uuid",
        "type": "string",
        "description": "첨부 id — list_attachments 결과의 items[].id"
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "GET",
    "path": "/attachments/{id}",
    "bindings": [
      {
        "input": "id",
        "in": "path",
        "name": "id"
      }
    ],
    "fixed": [
      {
        "in": "query",
        "name": "format",
        "value": "json"
      }
    ],
    "success": [
      200
    ]
  },
  "response": {
