{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "list_pages_by_label",
  "title": "라벨이 붙은 페이지 보기",
  "description": "라벨 하나가 붙은, 내가 읽을 수 있는 페이지 목록을 본다. 기본 100개까지 돌려준다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "라벨 이름 — 요청 글에 있는 라벨이나 list_labels 결과의 name"
      },
      "createdBy": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
        "description": "만든 사람의 아이디(username) — 요청에 만든 사람이 있을 때만 넣는다"
      },
      "updatedBy": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
        "description": "마지막으로 고친 사람의 아이디(username) — 요청에 고친 사람이 있을 때만 넣는다"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "GET",
    "path": "/labels/{name}/pages",
    "bindings": [
      {
        "input": "name",
        "in": "path",
        "name": "name"
      },
      {
        "input": "createdBy",
        "in": "query",
        "name": "createdBy"
      },
      {
        "input": "updatedBy",
        "in": "query",
        "name": "updatedBy"
      }
    ],
    "fixed": [],
    "omitted": [
      "limit"
    ],
    "success": [
      200
    ]
  },
  "response": {
    "fields": [
      "items[].pageId",
      "items[].title",
      "items[].spaceName",
      "items[].updatedAt",
      "items[].createdByName"
    ],
    "maxChars": 8000
  },
  "risk": "read",
  "scopes": [
    "read"
  ],
  "group": "read",
  "index": {
    "summary": "라벨(태그) 이름 하나로 그 라벨이 붙은 페이지들을 모아 본다",
