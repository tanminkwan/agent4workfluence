        "description": "페이지 id — search_pages 결과의 items[].pageId"
      }
    },
    "required": [
      "pageId"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "GET",
    "path": "/pages/{pageId}/attachments",
    "bindings": [
