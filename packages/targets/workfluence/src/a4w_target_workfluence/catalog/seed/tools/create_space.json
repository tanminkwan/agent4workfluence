{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "create_space",
  "title": "새 스페이스 만들기",
  "description": "새 팀 스페이스를 만든다. 만든 나는 owner가 된다. 같은 이름의 스페이스도 만들어지니 먼저 list_spaces로 겹치지 않는지 본다. 분류는 이름으로 고르고 없는 이름이면 404다. 사람을 넣으려면 만든 뒤 결과의 id로 add_space_member를 부른다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "category": {
        "anyOf": [
          {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "넣을 분류의 이름 — list_categories 결과의 name. 요청에 분류가 있을 때만 넣는다"
      },
      "description": {
        "default": "",
        "description": "스페이스 설명 — 요청에 있을 때만 넣는다",
        "maxLength": 2000,
        "type": "string"
      },
      "name": {
        "description": "스페이스 이름 — 200자까지",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "POST",
    "path": "/spaces",
    "contentType": "application/json",
    "bindings": [
      {
        "input": "category",
        "in": "body",
        "pointer": "/category"
      },
      {
        "input": "description",
        "in": "body",
        "pointer": "/description"
      },
      {
        "input": "name",
        "in": "body",
        "pointer": "/name"
      }
    ],
    "fixed": [],
    "success": [
      201
    ]
  },
  "response": {
    "fields": [
      "id",
      "name",
      "description",
      "status",
      "myRole"
    ],
    "maxChars": 8000
  },
  "risk": "write",
  "scopes": [
    "write"
  ],
  "group": "authoring",
  "index": {
    "summary": "위키에 새 스페이스(공간)를 만든다",
    "examples": [
      "새 스페이스 만들어줘",
      "스터디용 공간 하나 만들어줘",
      "팀 스페이스 새로 열어줘"
    ]
  },
