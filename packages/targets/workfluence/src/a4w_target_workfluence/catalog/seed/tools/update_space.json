{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "update_space",
  "title": "스페이스 고치기",
  "description": "스페이스의 이름·설명·분류를 고친다. 바꿀 것만 보낸다. owner만 고칠 수 있다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "format": "uuid",
        "type": "string",
        "description": "스페이스 id — list_spaces 결과의 items[].id"
      },
      "category": {
        "anyOf": [
          {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "새 분류의 이름 — list_categories 결과의 name. 바꿀 때만"
      },
      "description": {
        "description": "새 설명 — 바꿀 때만",
        "maxLength": 2000,
        "type": "string"
      },
      "name": {
        "description": "새 이름 — 바꿀 때만",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "PATCH",
    "path": "/spaces/{id}",
    "contentType": "application/json",
    "bindings": [
      {
        "input": "id",
        "in": "path",
        "name": "id"
      },
      {
        "input": "category",
        "in": "body",
        "pointer": "/category"
      },
      {
        "input": "description",
        "in": "body",
        "pointer": "/description"
      },
      {
        "input": "name",
        "in": "body",
        "pointer": "/name"
      }
    ],
    "fixed": [],
    "success": [
      200
    ]
  },
  "response": {
    "fields": [
      "id",
      "name",
      "description",
      "status"
    ],
    "maxChars": 8000
  },
  "risk": "write",
  "scopes": [
    "write"
  ],
  "group": "authoring",
  "index": {
    "summary": "이미 있는 스페이스의 이름·설명·분류를 고친다. 만들거나 지우지 않는다",
    "examples": [
      "스페이스 이름 바꿔줘",
      "공간 설명 새로 써줘",
