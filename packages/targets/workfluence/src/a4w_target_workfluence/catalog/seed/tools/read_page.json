{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "read_page",
  "title": "페이지 읽기",
  "description": "페이지 하나를 본문(마크다운)과 함께 읽는다. 지금 버전 번호(currentVersionNo)가 함께 온다 — 이 페이지를 고칠 때 update_page의 baseVersionNo로 그대로 쓴다. 제목만 알면 read_page_by_title을 쓴다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "format": "uuid",
        "type": "string",
        "description": "페이지 id — search_pages 결과의 items[].pageId나 list_pages 결과의 items[].id"
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "GET",
    "path": "/pages/{id}",
    "bindings": [
      {
        "input": "id",
        "in": "path",
        "name": "id"
      }
    ],
    "fixed": [],
    "omitted": [
      "format"
    ],
    "success": [
      200
    ]
  },
  "response": {
    "fields": [
      "id",
      "title",
      "body",
      "currentVersionNo",
      "ancestors[].title",
      "updatedAt",
      "createdByUsername",
      "createdByName",
      "updatedByName"
    ],
    "maxChars": 8000
  },
  "risk": "read",
  "scopes": [
    "read"
  ],
  "group": "read",
  "index": {
    "summary": "이미 고른 페이지 하나(id를 앎)의 본문 전체를 읽는다. 제목만 알 때는 제목으로 찾아 읽기를 쓴다",
    "examples": [
      "방금 찾은 페이지 본문 읽어줘",
      "그 문서 전체 내용 보여줘",
      "목록에서 고른 페이지 열어줘",
      "이 페이지 내용 요약해줘",
      "이 글 무슨 내용이야?",
      "페이지 본문 읽기",
      "Read the page content",
      "Open that page and summarize it"
    ]
  },
