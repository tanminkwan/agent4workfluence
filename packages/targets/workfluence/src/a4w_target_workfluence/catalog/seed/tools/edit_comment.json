        "input": "id",
        "in": "path",
        "name": "id"
      },
      {
        "input": "body",
        "in": "body",
        "pointer": "/body"
      }
    ],
    "fixed": [],
    "omitted": [
      "format",
      "body_format"
    ],
    "success": [
      200
    ]
