{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "add_comment",
  "title": "페이지에 댓글 달기",
  "description": "페이지에 새 댓글을 단다. 본문은 마크다운이고 원시 HTML·그림은 400이다. 본문의 @사용자는 멘션이 되어 알림이 간다. 제목만 알면 comment_on_page_by_title을 쓴다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pageId": {
        "format": "uuid",
        "type": "string",
        "description": "댓글을 달 페이지 id — search_pages 결과의 items[].pageId"
      },
      "body": {
        "description": "댓글 본문 (마크다운 글)"
      }
    },
    "required": [
      "pageId",
      "body"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "POST",
    "path": "/pages/{pageId}/comments",
    "contentType": "application/json",
    "bindings": [
      {
        "input": "pageId",
        "in": "path",
        "name": "pageId"
      },
      {
        "input": "body",
        "in": "body",
        "pointer": "/body"
      }
    ],
    "fixed": [],
    "omitted": [
      "format",
      "body_format",
      "parentId"
    ],
    "success": [
      201
    ]
  },
  "response": {
    "fields": [
      "id",
      "createdAt"
    ],
    "maxChars": 8000
  },
  "risk": "write",
  "scopes": [
    "write"
  ],
  "group": "communication",
  "index": {
    "summary": "이미 고른 페이지(id를 앎)에 댓글이나 답글을 새로 단다",
    "examples": [
      "이 페이지에 댓글 남겨줘",
      "좋아요라고 댓글 써줘",
      "그 댓글에 답글 달아줘",
      "질문을 댓글로 올려줘",
      "문서에 피드백 남겨",
      "페이지에 댓글 달기",
      "Add a comment to this page",
      "Reply to that comment"
    ]
  },
