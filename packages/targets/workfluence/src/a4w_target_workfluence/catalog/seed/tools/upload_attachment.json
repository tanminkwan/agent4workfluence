{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "upload_attachment",
  "title": "첨부 올리기",
  "description": "페이지에 글 파일을 첨부로 올린다(utf8 글). 형식은 확장자로 정하고 허용 확장자만 올라간다. 파일 이름에 / \\ 를 쓸 수 없다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pageId": {
        "format": "uuid",
        "type": "string",
        "description": "첨부를 올릴 페이지 id — search_pages 결과의 items[].pageId"
      },
      "content": {
        "description": "파일 내용 (글)",
        "minLength": 1,
        "type": "string"
      },
      "filename": {
        "description": "파일 이름 (예: 요약.txt) — 255자까지",
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "pageId",
      "content",
      "filename"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "POST",
    "path": "/pages/{pageId}/attachments",
    "contentType": "application/json",
    "bindings": [
      {
        "input": "pageId",
        "in": "path",
        "name": "pageId"
      },
      {
        "input": "content",
        "in": "body",
        "pointer": "/content"
      },
      {
        "input": "filename",
        "in": "body",
        "pointer": "/filename"
      }
    ],
    "fixed": [],
    "omitted": [
      "encoding"
    ],
    "success": [
      201
    ]
  },
  "response": {
    "fields": [
      "id",
      "filename",
      "href"
    ],
    "maxChars": 8000
  },
  "risk": "danger",
  "scopes": [
    "write"
  ],
  "group": "danger",
  "index": {
    "summary": "페이지에 파일을 첨부로 올린다",
    "examples": [
      "이 내용을 파일로 첨부해줘",
      "회의록에 메모 파일 올려",
      "텍스트 파일 붙여줘",
      "첨부로 정리본 올려줘",
      "문서에 파일 업로드",
      "페이지에 첨부 올리기",
      "Attach a file to this page",
      "Upload a note as an attachment"
    ]
  },
  "source": {
    "operationId": "attachments.upload",
    "method": "POST",
    "path": "/pages/{pageId}/attachments",
    "specVersion": "8c83f9c66a3a6a0acc82bbc386954cffb2fc24fb031f21bf123700e518a2b1e6",
