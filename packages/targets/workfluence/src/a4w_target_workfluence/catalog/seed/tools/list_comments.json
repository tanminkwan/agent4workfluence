{
  "schema": "a4w.tool/v1",
  "kind": "operation",
  "name": "list_comments",
  "title": "페이지의 댓글 보기",
  "description": "페이지에 달린 댓글과 답글을 시간순으로 본다. 답글은 parentId가 상위 댓글 id다.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pageId": {
        "format": "uuid",
        "type": "string",
        "description": "페이지 id — search_pages 결과의 items[].pageId"
      },
      "author": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
        "description": "쓴 사람의 아이디(username) — 요청에 댓글 쓴 사람이 있을 때만 넣는다"
      }
    },
    "required": [
      "pageId"
    ],
    "additionalProperties": false
  },
  "http": {
    "method": "GET",
    "path": "/pages/{pageId}/comments",
    "bindings": [
      {
        "input": "pageId",
        "in": "path",
        "name": "pageId"
      },
      {
        "input": "author",
        "in": "query",
        "name": "author"
      }
    ],
    "fixed": [],
    "omitted": [
      "format"
    ],
    "success": [
      200
    ]
  },
  "response": {
    "fields": [
      "items[].id",
      "items[].author",
      "items[].authorUsername",
      "items[].body",
      "items[].parentId",
      "items[].createdAt"
    ],
    "maxChars": 8000
  },
  "risk": "read",
  "scopes": [
    "read"
  ],
  "group": "communication",
  "index": {
    "summary": "페이지 하나에 달린 댓글과 답글을 읽는다. 댓글을 쓰지는 않는다",
    "examples": [
      "이 페이지 댓글 보여줘",
      "누가 무슨 의견 달았어?",
      "답글까지 다 읽어줘",
      "민수가 단 댓글만 보여줘",
      "문서에 달린 피드백 정리해줘",
      "페이지 댓글 목록 보기",
      "Show comments on this page",
      "What did people comment?"
    ]
  },
  "source": {
    "operationId": "comments.list",
