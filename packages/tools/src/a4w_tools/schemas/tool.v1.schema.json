{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a4w.local/schemas/tool.v1.schema.json",
  "title": "a4w tool 정의 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "name", "title", "description", "inputSchema", "risk", "scopes", "group", "index", "origin", "revision"],
  "properties": {
    "schema": {"const": "a4w.tool/v1"},
    "kind": {"enum": ["operation", "composite", "handler"]},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "inputSchema": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object"},
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "additionalProperties": {"const": false}
      }
    },
    "http": {"$ref": "#/$defs/http"},
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "maxChars": {"type": "integer", "minimum": 100}
      }
    },
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "output": {"$ref": "#/$defs/stepRef"},
    "handler": {"type": "string", "minLength": 1},
    "risk": {"enum": ["read", "write", "danger"]},
    "scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "group": {"type": "string", "minLength": 1},
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "examples"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "examples": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "method", "path", "specVersion", "fragmentSha256", "structureSha256"],
      "properties": {
        "operationId": {"type": ["string", "null"]},
        "method": {"type": "string"},
        "path": {"type": "string"},
        "specVersion": {"type": "string"},
        "fragmentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "structureSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "origin": {"enum": ["seed", "llm", "llm-doc"]},
    "revision": {"type": "string", "pattern": "^r-[0-9a-f]{12}$"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "operation"}}}, "then": {"required": ["http", "source"]}},
    {"if": {"properties": {"kind": {"const": "composite"}}}, "then": {"required": ["steps"]}},
    {"if": {"properties": {"kind": {"const": "handler"}}}, "then": {"required": ["handler"]}}
  ],
  "$defs": {
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "bindings"],
      "properties": {
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
        "path": {"type": "string", "pattern": "^/"},
        "contentType": {"type": "string"},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "fixed": {"type": "array", "items": {"$ref": "#/$defs/fixed"}},
        "omitted": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "success": {"type": "array", "items": {"type": "integer", "minimum": 100, "maximum": 599}}
      }
    },
    "location": {"enum": ["path", "query", "header", "body"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "in"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "in": {"$ref": "#/$defs/location"},
        "name": {"type": "string", "minLength": 1},
        "pointer": {"type": "string"},
        "contextDefault": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"}
      },
      "if": {"properties": {"in": {"const": "body"}}},
      "then": {"required": ["pointer"]},
      "else": {"required": ["name"]}
    },
    "fixed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in"],
      "properties": {
        "in": {"$ref": "#/$defs/location"},
        "name": {"type": "string", "minLength": 1},
        "pointer": {"type": "string"},
        "value": {},
        "context": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"}
      },
      "oneOf": [{"required": ["value"], "not": {"required": ["context"]}}, {"required": ["context"], "not": {"required": ["value"]}}],
      "if": {"properties": {"in": {"const": "body"}}},
      "then": {"required": ["pointer"]},
      "else": {"required": ["name"]}
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool", "args"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "args": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pointer", "count"],
          "properties": {
            "pointer": {"type": "string"},
            "count": {"enum": ["one", "some"]}
          }
        }
      }
    },
    "stepRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$step"],
      "properties": {"$step": {"type": "string"}, "pointer": {"type": "string"}}
    },
    "value": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["$input"], "properties": {"$input": {"type": "string"}}},
        {"$ref": "#/$defs/stepRef"},
        {"type": "object", "additionalProperties": false, "required": ["$const"], "properties": {"$const": {}}}
      ]
    }
  }
}
